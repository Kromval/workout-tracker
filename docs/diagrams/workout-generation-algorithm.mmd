%% Алгоритм генерации тренировки
flowchart TD
  start([Запрос на генерацию тренировки])
  input["Параметры пользователя:\nдлительность, тип, цели,\nоборудование, ограничения"]
  normalize["Нормализация запроса"]
  profile["Чтение профиля и истории"]
  candidates["Загрузка каталога упражнений"]
  hardFilters["Жесткая фильтрация:\nоборудование, уровень,\nпротивопоказания"]
  scoring["Скоринг упражнений:\nцели, мышцы, теги,\nразнообразие, история"]
  slots["Построение шаблона слотов"]
  select["Подбор упражнения для каждого слота"]
  dosage["Назначение подходов,\nповторов, длительности и отдыха"]
  fitDuration["Подгонка объема под целевую длительность"]
  validate["Валидация и нормализация тренировки"]
  save["Сохранение как обычной тренировки"]
  result([Готовая тренировка])

  start --> input --> normalize
  normalize --> profile
  normalize --> candidates
  profile --> hardFilters
  candidates --> hardFilters
  hardFilters --> scoring --> slots --> select --> dosage
  dosage --> fitDuration --> validate --> save --> result
